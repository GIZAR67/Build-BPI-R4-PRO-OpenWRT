CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y
CONFIG_TARGET_mediatek_filogic_DEVICE_bananapi_bpi-r4-pro-8x=y
CONFIG_TARGET_ROOTFS_INITRAMFS=y
CONFIG_TARGET_ROOTFS_INITRAMFS_SEPARATE=y
CONFIG_TARGET_ROOTFS_SQUASHFS=y

# TUN support (required for amneziawg-go userspace)
CONFIG_PACKAGE_kmod-tun=y

# AmneziaWG
CONFIG_PACKAGE_amneziawg-tools=y
CONFIG_PACKAGE_luci-proto-amneziawg=y
CONFIG_PACKAGE_kmod-amneziawg=y

# Aeonsemi AS21x1x PHY — 10G RJ45 WAN (комбо-порт SFP/RJ45)
# Без драйвера и прошивки PHY порт RJ45 WAN не работает
CONFIG_PACKAGE_kmod-phy-as21xxx=y
CONFIG_PACKAGE_as21xxx-firmware=y

# WireGuard (kernel module + tools)
CONFIG_PACKAGE_kmod-wireguard=y
CONFIG_PACKAGE_wireguard-tools=y
CONFIG_PACKAGE_luci-proto-wireguard=y

# zapret — обход блокировок (фид remittor, ветка zap1)
CONFIG_PACKAGE_zapret=y
CONFIG_PACKAGE_luci-app-zapret=y

# Модули netfilter для zapret (NFQUEUE)
CONFIG_PACKAGE_kmod-nft-queue=y
CONFIG_PACKAGE_kmod-nfnetlink-queue=y

# Диагностика
CONFIG_PACKAGE_tcpdump=y
CONFIG_PACKAGE_iperf3=y
CONFIG_PACKAGE_ethtool-full=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_jq=y
CONFIG_PACKAGE_iw-full=y

# Здоровье накопителей (eMMC/SD/NAND)
CONFIG_PACKAGE_mmc-utils=y
CONFIG_PACKAGE_nand-utils=y

# USB-накопители
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-fs-exfat=y
CONFIG_PACKAGE_kmod-fs-ntfs3=y

# Резервный канал через USB-модем
CONFIG_PACKAGE_uqmi=y
CONFIG_PACKAGE_kmod-usb-net-qmi-wwan=y

# Русский LuCI.
# Пакеты luci-i18n-*-ru объявлены в luci.mk с HIDDEN:=1 и DEFAULT:=LUCI_LANG_ru,
# поэтому напрямую они не включаются — defconfig молча сбрасывает их к умолчанию.
# Включается язык целиком, и переводы приезжают для всех выбранных пакетов LuCI.
CONFIG_LUCI_LANG_ru=y

# Disable mihomo (build error in feeds/small)
# CONFIG_PACKAGE_mihomo is not set
# CONFIG_PACKAGE_luci-app-mihomo is not set

# podkop/sing-box НЕ включаем: 44 МБ и перехват DNS целиком,
# заменяет собой нашу схему раздельного доступа (см. WIKI T-004.17 п.3.2)
# CONFIG_PACKAGE_podkop is not set
# CONFIG_PACKAGE_sing-box is not set

# --- Веб-интерфейс LuCI ---
# Без пакета `luci` в образ не попадает веб-сервер: на домашней Банане после прошивки
# 16.08.2026 порт 80 не слушал никто, роутер настраивался только по SSH.
# Пакет `luci` тянет за собой uhttpd, темы и разделы Status/Network/System.
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_uhttpd=y
CONFIG_PACKAGE_uhttpd-mod-ubus=y
CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_luci-app-package-manager=y
CONFIG_PACKAGE_luci-proto-ipv6=y
CONFIG_PACKAGE_luci-proto-ppp=y
CONFIG_PACKAGE_rpcd-mod-iwinfo=y
CONFIG_PACKAGE_rpcd-mod-rrdns=y

# QR-коды клиентских конфигов AWG — страница «VPN-клиенты» рисует их этим пакетом
CONFIG_PACKAGE_qrencode=y

# dnsmasq-full вместо базового: базовая сборка идёт с no-nftset, а на наборах
# nftables держится вся схема раздельного доступа (домены -> набор -> метка).
# CONFIG_PACKAGE_dnsmasq is not set
CONFIG_PACKAGE_dnsmasq-full=y

# Монтирование разделов через uci (eMMC, USB) — на рабочем роутере есть, в образе не было
CONFIG_PACKAGE_block-mount=y

# ============================================================================
# Полный состав: всё, что умеют заводская прошивка Бананы и сборка Octava.
# Списки сняты 16.08.2026 из копии заводского тома fit (434 пакета) и образа
# Octava Connect build18 (440 пакетов) и вычтены из нашего состава.
# ============================================================================

# --- Прошивки PHY и утилиты MediaTek — без них часть портов и отладки заводской платы недоступна ---
CONFIG_PACKAGE_airoha-en8811h-firmware=y
CONFIG_PACKAGE_aqr10g-phy-firmware=y
# CONFIG_PACKAGE_mt7988-2p5g-phy-firmware is not set
# CONFIG_PACKAGE_mt798x-2p5g-phy-firmware-internal is not set
CONFIG_PACKAGE_kmod-phy-airoha-an8801sb=y
CONFIG_PACKAGE_kmod-phy-airoha-en8811h=y
CONFIG_PACKAGE_kmod-phy-marvell=y
CONFIG_PACKAGE_kmod-phy-marvell-10g=y
CONFIG_PACKAGE_mtkhnat_util=y
CONFIG_PACKAGE_mtk_factory_rw=y
CONFIG_PACKAGE_mii_mgr=y
CONFIG_PACKAGE_ephy-utils=y
CONFIG_PACKAGE_ethswbox=y
CONFIG_PACKAGE_netsys_dbg_util=y
CONFIG_PACKAGE_regs=y
CONFIG_PACKAGE_smp_util=y
CONFIG_PACKAGE_switch=y
CONFIG_PACKAGE_afcd=y
CONFIG_PACKAGE_atenl=y
CONFIG_PACKAGE_mt76-test=y
CONFIG_PACKAGE_netfilter-flowtable=y

# --- Файловые шары и печать — заводская прошивка это умела ---
CONFIG_PACKAGE_samba4-server=y
CONFIG_PACKAGE_luci-app-samba4=y
CONFIG_PACKAGE_ksmbd-server=y
CONFIG_PACKAGE_luci-app-ksmbd=y
CONFIG_PACKAGE_wsdd2=y
CONFIG_PACKAGE_avahi-dbus-daemon=y
CONFIG_PACKAGE_dbus=y
CONFIG_PACKAGE_p910nd=y
CONFIG_PACKAGE_luci-app-p910nd=y
CONFIG_PACKAGE_kmod-fs-ksmbd=y
CONFIG_PACKAGE_kmod-fs-smbfs-common=y
CONFIG_PACKAGE_kmod-fs-exportfs=y
CONFIG_PACKAGE_kmod-fs-nfs-common=y
CONFIG_PACKAGE_kmod-fs-nfs-common-rpcsec=y
CONFIG_PACKAGE_kmod-fs-nfsd=y
CONFIG_PACKAGE_kmod-fs-netfs=y
CONFIG_PACKAGE_kmod-fs-autofs4=y

# --- Накопители и файловые системы ---
CONFIG_PACKAGE_kmod-nvme=y
CONFIG_PACKAGE_kmod-ata-core=y
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_kmod-fs-vfat=y
CONFIG_PACKAGE_kmod-fs-msdos=y
CONFIG_PACKAGE_kmod-scsi-generic=y
CONFIG_PACKAGE_kmod-usb-storage-extras=y
CONFIG_PACKAGE_kmod-usb-storage-uas=y
CONFIG_PACKAGE_kmod-nls-cp437=y
CONFIG_PACKAGE_kmod-nls-iso8859-1=y
CONFIG_PACKAGE_kmod-nls-ucs2-utils=y
CONFIG_PACKAGE_kmod-nls-utf8=y
CONFIG_PACKAGE_blkid=y
CONFIG_PACKAGE_lsblk=y
CONFIG_PACKAGE_sfdisk=y
CONFIG_PACKAGE_blockd=y
CONFIG_PACKAGE_fio=y
CONFIG_PACKAGE_kmod-lib-crc16=y

# --- Прокси и обходные протоколы из Octava и заводской (ставим, службы не включаем) ---
CONFIG_PACKAGE_luci-app-ssr-plus=y
CONFIG_PACKAGE_shadowsocks-rust-sslocal=y
CONFIG_PACKAGE_shadowsocks-rust-ssserver=y
CONFIG_PACKAGE_shadowsocksr-libev-ssr-check=y
CONFIG_PACKAGE_shadowsocksr-libev-ssr-local=y
CONFIG_PACKAGE_shadowsocksr-libev-ssr-redir=y
CONFIG_PACKAGE_shadowsocksr-libev-ssr-server=y
CONFIG_PACKAGE_xray-core=y
# v2ray-plugin требует Go >= 1.25.5, в дереве 1.23.10 — та же стена, что у mosdns.
# Транспорт для Shadowsocks в ssr-plus, в нашей схеме (AmneziaWG + xray) не используется.
# CONFIG_PACKAGE_v2ray-plugin is not set
CONFIG_PACKAGE_simple-obfs-client=y
CONFIG_PACKAGE_dns2socks=y
CONFIG_PACKAGE_dns2tcp=y
CONFIG_PACKAGE_ipt2socks=y
CONFIG_PACKAGE_microsocks=y
# CONFIG_PACKAGE_mosdns is not set

# --- podkop + sing-box из Octava. Ставим пакетом, службу НЕ поднимаем: подкоп перехватывает DNS целиком и заменяет нашу схему раздельного доступа (T-004.17 п.3.2) ---
CONFIG_PACKAGE_podkop=y
CONFIG_PACKAGE_luci-app-podkop=y
CONFIG_PACKAGE_sing-box=y

# --- Классические VPN-протоколы (OpenVPN, L2TP, PPTP) ---
