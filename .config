CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y
CONFIG_TARGET_mediatek_filogic_DEVICE_bananapi_bpi-r4-pro-8x=y
CONFIG_TARGET_ROOTFS_INITRAMFS=y
CONFIG_TARGET_ROOTFS_INITRAMFS_SEPARATE=y
CONFIG_TARGET_ROOTFS_SQUASHFS=y

# TUN support (required for amneziawg-go userspace)
CONFIG_PACKAGE_kmod-tun=y

# AmneziaWG
CONFIG_PACKAGE_amneziawg-tools=y
CONFIG_PACKAGE_luci-proto-amneziawg=y
CONFIG_PACKAGE_kmod-amneziawg=y

# Aeonsemi AS21x1x PHY — 10G RJ45 WAN (комбо-порт SFP/RJ45)
# Без драйвера и прошивки PHY порт RJ45 WAN не работает
CONFIG_PACKAGE_kmod-phy-as21xxx=y
CONFIG_PACKAGE_as21xxx-firmware=y

# WireGuard (kernel module + tools)
CONFIG_PACKAGE_kmod-wireguard=y
CONFIG_PACKAGE_wireguard-tools=y
CONFIG_PACKAGE_luci-proto-wireguard=y

# zapret — обход блокировок (фид remittor, ветка zap1)
CONFIG_PACKAGE_zapret=y
CONFIG_PACKAGE_luci-app-zapret=y

# Модули netfilter для zapret (NFQUEUE)
CONFIG_PACKAGE_kmod-nft-queue=y
CONFIG_PACKAGE_kmod-nfnetlink-queue=y

# Диагностика
CONFIG_PACKAGE_tcpdump=y
CONFIG_PACKAGE_iperf3=y
CONFIG_PACKAGE_ethtool-full=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_jq=y
CONFIG_PACKAGE_iw-full=y

# Здоровье накопителей (eMMC/SD/NAND)
CONFIG_PACKAGE_mmc-utils=y
CONFIG_PACKAGE_nand-utils=y

# USB-накопители
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-fs-exfat=y
CONFIG_PACKAGE_kmod-fs-ntfs3=y

# Резервный канал через USB-модем
CONFIG_PACKAGE_uqmi=y
CONFIG_PACKAGE_kmod-usb-net-qmi-wwan=y

# Русский LuCI.
# Пакеты luci-i18n-*-ru объявлены в luci.mk с HIDDEN:=1 и DEFAULT:=LUCI_LANG_ru,
# поэтому напрямую они не включаются — defconfig молча сбрасывает их к умолчанию.
# Включается язык целиком, и переводы приезжают для всех выбранных пакетов LuCI.
CONFIG_LUCI_LANG_ru=y

# Disable mihomo (build error in feeds/small)
# CONFIG_PACKAGE_mihomo is not set
# CONFIG_PACKAGE_luci-app-mihomo is not set

# podkop/sing-box НЕ включаем: 44 МБ и перехват DNS целиком,
# заменяет собой нашу схему раздельного доступа (см. WIKI T-004.17 п.3.2)
# CONFIG_PACKAGE_podkop is not set
# CONFIG_PACKAGE_sing-box is not set

# --- Веб-интерфейс LuCI ---
# Без пакета `luci` в образ не попадает веб-сервер: на домашней Банане после прошивки
# 16.08.2026 порт 80 не слушал никто, роутер настраивался только по SSH.
# Пакет `luci` тянет за собой uhttpd, темы и разделы Status/Network/System.
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_uhttpd=y
CONFIG_PACKAGE_uhttpd-mod-ubus=y
CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_luci-app-package-manager=y
CONFIG_PACKAGE_luci-proto-ipv6=y
CONFIG_PACKAGE_luci-proto-ppp=y
CONFIG_PACKAGE_rpcd-mod-iwinfo=y
CONFIG_PACKAGE_rpcd-mod-rrdns=y

# QR-коды клиентских конфигов AWG — страница «VPN-клиенты» рисует их этим пакетом
CONFIG_PACKAGE_qrencode=y

# dnsmasq-full вместо базового: базовая сборка идёт с no-nftset, а на наборах
# nftables держится вся схема раздельного доступа (домены -> набор -> метка).
# CONFIG_PACKAGE_dnsmasq is not set
CONFIG_PACKAGE_dnsmasq-full=y

# Монтирование разделов через uci (eMMC, USB) — на рабочем роутере есть, в образе не было
CONFIG_PACKAGE_block-mount=y
